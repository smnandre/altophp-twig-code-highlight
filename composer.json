{
    "name": "alto/twig-code-highlight",
    "description": "Twig extension for Alto Code Highlight with code_highlight tag and filter",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "twig",
        "twig-extension",
        "twig-filter",
        "twig-tag",
        "code-highlighting",
        "syntax-highlighting",
        "alto",
        "code-highlight"
    ],
    "authors": [
        {
            "name": "Simon André",
            "email": "smn.andre@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "alto/code-highlight": "*@dev",
        "twig/twig": "^3.23"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Alto\\Twig\\CodeHighlight\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alto\\Twig\\CodeHighlight\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "coverage": "vendor/bin/phpunit --coverage-text",
        "cs": "vendor/bin/php-cs-fixer fix --diff",
        "qa": [
            "@cs",
            "@sa",
            "@test"
        ],
        "sa": "vendor/bin/phpstan analyse --memory-limit=-1",
        "test": "vendor/bin/phpunit"
    }
}
