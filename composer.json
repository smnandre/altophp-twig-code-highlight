{
    "name": "alto/twig-code-highlight",
    "description": "Highlight source code in Twig templates with a tag or filter.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "twig",
        "twig-extension",
        "twig-filter",
        "twig-tag",
        "code-highlighting",
        "syntax-highlighting",
        "alto",
        "code-highlight"
    ],
    "authors": [
        {
            "name": "Simon André",
            "email": "smn.andre@gmail.com"
        }
    ],
    "homepage": "https://altophp.com/twig-code-highlight",
    "support": {
        "issues": "https://github.com/altophp/twig-code-highlight/issues",
        "source": "https://github.com/altophp/twig-code-highlight",
        "docs": "https://altophp.com/twig-code-highlight"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/smnandre"
        }
    ],
    "require": {
        "php": "^8.4",
        "alto/code-highlight": "^1.0",
        "twig/twig": "^3.28"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Alto\\Twig\\CodeHighlight\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alto\\Twig\\CodeHighlight\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "coverage": "vendor/bin/phpunit --coverage-text",
        "cs": "vendor/bin/php-cs-fixer fix --dry-run --diff --sequential",
        "cs:fix": "vendor/bin/php-cs-fixer fix --sequential",
        "qa": [
            "@cs",
            "@sa",
            "@test"
        ],
        "sa": "vendor/bin/phpstan analyse --memory-limit=-1",
        "test": "phpunit"
    }
}
